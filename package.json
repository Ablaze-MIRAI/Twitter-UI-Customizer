{
    "private": true,
    "type": "module",
    "scripts": {
        "build": "pnpm run build:firefox",
        "build:firefox": "vite build --mode firefox",
        "build:chromium": "vite build --mode chromium",
        "debug": "pnpm run debug:firefox",
        "debug:firefox": "pnpm run build:firefox --watch",
        "debug:chromium": "pnpm run build:chromium --watch",
        "debug:firefox-android": "vite build --mode firefox-android --watch",
        "clean": "node -e \"(await import('fs')).rmSync('dist', { recursive: true, force: true })\"",
        "type-check": "pnpm run lint:tsc",
        "lint": "pnpm run lint:tsc & pnpm run lint:eslint & pnpm run lint:stylelint",
        "lint:tsc": "vue-tsc --build --noEmit",
        "lint:eslint": "eslint .",
        "lint:stylelint": "stylelint **/*.{css,vue}",
        "format": "pnpm run format:eslint & pnpm run format:stylelint",
        "format:eslint": "eslint --fix .",
        "format:stylelint": "stylelint --fix **/*.{css,vue}"
    },
    "dependencies": {
        "bootstrap-icons": "^1.13.1",
        "pinia": "^4.0.3",
        "solid-js": "^1.9.14",
        "vue": "^3.5.41"
    },
    "devDependencies": {
        "@antfu/eslint-config": "^9.3.0",
        "@csstools/stylelint-formatter-github": "^2.0.0",
        "@stylistic/stylelint-config": "^5.0.0",
        "@types/chrome": "^0.2.6",
        "@types/node": "^24.13.3",
        "@types/webextension-polyfill": "^0.12.5",
        "@unocss/eslint-plugin": "^66.7.5",
        "@unocss/postcss": "^66.7.5",
        "@vitejs/plugin-vue": "^6.0.8",
        "crx": "^5.0.1",
        "eslint": "^10.8.1",
        "eslint-import-resolver-typescript": "^4.4.5",
        "eslint-plugin-import-x": "^4.17.1",
        "eslint-plugin-solid": "^0.15.0",
        "globals": "^17.11.0",
        "lightningcss": "1.30.1",
        "postcss": "^8.5.26",
        "stylelint": "^17.14.1",
        "stylelint-config-recess-order": "^7.8.0",
        "stylelint-config-recommended-vue": "^2.0.0",
        "stylelint-config-standard": "^40.0.0",
        "stylelint-use-nesting": "^6.0.2",
        "typescript": "npm:@typescript/typescript6@^6.0.2",
        "unocss": "^66.7.5",
        "vite": "^8.2.1",
        "vite-plugin-solid": "^2.11.14",
        "vite-svg-loader": "^5.1.1",
        "vue-tsc": "^3.3.9",
        "web-ext": "^10.6.0"
    },
    "devEngines": {
        "runtime": {
            "name": "node",
            "version": ">=24.11",
            "onFail": "error"
        },
        "packageManager": {
            "name": "pnpm",
            "version": ">=11",
            "onFail": "error"
        }
    }
}
